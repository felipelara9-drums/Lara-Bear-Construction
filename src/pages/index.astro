---
const companyName = "Lara Bear Construction";
const email = "larabearco@outlook.com";
const phone = "559-892-6331";
const phoneClean = "5598926331";
const services = [
  {
    title: "Restoration / Remodeling",
    description: "Full-service restoration and remodeling. Water damage repair, kitchen and bathroom remodels, and whole-home renovations.",
    icon: "🔨",
    features: ["Water Damage Restoration", "Kitchen Remodel", "Bathroom Remodel", "Whole-Home Renovation"],
    link: "/restoration-remodeling"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${companyName} — Restoration and remodeling services. Quality construction you can trust.`} />
    <title>{companyName} | Restoration & Remodeling</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo" aria-label="Lara Bear Construction home">
          <span class="site-name">{companyName}</span>
        </a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote">Free Quote</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="eyebrow">Built for strength. Built to last.</p>
        <h1>Quality Construction<br /><span class="hero-accent">Done Right the First Time</span></h1>
        <p class="hero-copy">{companyName} delivers dependable restoration and remodeling services with craftsmanship that holds up.</p>
        <div class="hero-buttons">
          <a href="/quote" class="btn btn-primary">Get a Free Quote</a>
          <a href="#services" class="btn btn-outline">Our Services</a>
        </div>
      </div>
    </section>

    <section class="trust-bar">
      <div class="trust-item"><strong>10+</strong><span>Years Experience</span></div>
      <div class="trust-item"><strong>500+</strong><span>Projects Completed</span></div>
      <div class="trust-item"><strong>100%</strong><span>Satisfaction Guaranteed</span></div>
      <div class="trust-item"><strong>24/7</strong><span>Emergency Service</span></div>
    </section>

    <section id="services" class="section">
      <div class="section-header">
        <span class="section-tag">What We Do</span>
        <h2>Our Services</h2>
        <p>One area of expertise — click to learn more.</p>
      </div>
      <div class="service-cards">
        {services.map((service) => (
          <a href={service.link} class="service-card">
            <div class="service-icon">{service.icon}</div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul class="service-features">
              {service.features.map((feature) => (<li>✓ {feature}</li>))}
            </ul>
            <span class="service-link">Learn More →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="about" class="section section-alt">
      <div class="about-container">
        <div class="about-text">
          <span class="section-tag">Who We Are</span>
          <h2>Built on Trust, Quality, and Hard Work</h2>
          <p>{companyName} is a full-service construction company serving homeowners and businesses with pride. We specialize in restoration and remodeling — delivering craftsmanship and reliability on every project.</p>
          <p>Every project, big or small, gets the same attention to detail. We show up on time, communicate clearly, and stand behind our work with a satisfaction guarantee.</p>
          <a href="/quote" class="btn btn-primary">Work With Us</a>
        </div>

        <div class="about-stats">
          <div class="stat-box"><strong>10+</strong><span>Years in Business</span></div>
          <div class="stat-box"><strong>500+</strong><span>Happy Clients</span></div>
          <div class="stat-box"><strong>Licensed</strong><span>& Insured</span></div>
          <div class="stat-box"><strong>Free</strong><span>Estimates</span></div>
        </div>
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <div class="contact-container">
        <div class="contact-info-block">
          <span class="section-tag">Get In Touch</span>
          <h2>Ready to Start Your Project?</h2>
          <p>Reach out today for a free consultation and estimate. We’ll get back to you within 24 hours.</p>

          <div class="contact-details">
            <div class="contact-item">
              <span class="contact-icon">📧</span>
              <div><strong>Email</strong><a href={`mailto:${email}`}>{email}</a></div>
            </div>
            <div class="contact-item">
              <span class="contact-icon">📞</span>
              <div><strong>Phone</strong><a href={`tel:+1${phoneClean}`}>{phone}</a></div>
            </div>
            <div class="contact-item">
              <span class="contact-icon">📍</span>
              <div><strong>Service Area</strong><span>Serving local homeowners and businesses in the San Joaquin area</span></div>
            </div>
          </div>
        </div>

        <form class="contact-form" onsubmit={`event.preventDefault(); window.location.href='mailto:${email}?subject=Free Quote Request';`}>
          <h3>Request a Free Quote</h3>
          <input type="text" placeholder="Your Name" required />
          <input type="email" placeholder="Your Email" required />
          <input type="tel" placeholder="Your Phone" />
          <select required>
            <option value="" disabled selected>Select a Service</option>
            <option>Restoration / Remodeling</option>
          </select>
          <textarea placeholder="Tell us about your project" rows="4"></textarea>
          <button type="submit" class="btn btn-primary btn-full">Send Request</button>
        </form>
      </div>
    </section>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-wordmark">{companyName}</span>
        </div>
        <p>Restoration / Remodeling</p>

        <nav class="footer-nav">
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Free Quote</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

        <p class="license-number">
          CSLB License #1159060
        </p>

        <p class="copyright">
          &copy; {new Date().getFullYear()} {companyName}. All rights reserved.
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --navy-950: #0b1d2d;
        --navy-900: #102c40;
        --navy-800: #163d5d;
        --navy-700: #1b4d73;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --text: #1a1a1a;
        --muted: #556274;
        --warm: #f5f1eb;
        --light: #f9f9f7;
        --panel: #ffffff;
      }

      *{margin:0;padding:0;box-sizing:border-box;}
      html { scroll-behavior: smooth; }
      body{
        font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height:1.6;
        color:var(--text);
        background:
          radial-gradient(circle at top, rgba(212,160,23,0.07), transparent 30%),
          linear-gradient(135deg, #f5f1eb 0%, #f9f9f7 100%);
        letter-spacing: 0.01em;
      }
      a{text-decoration:none;color:inherit;}
      img { max-width: 100%; display: block; }

      .site-header{
        position:sticky;
        top:0;
        z-index:100;
        background:rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.5);
        box-shadow: 0 10px 30px rgba(12, 26, 38, 0.18);
      }

      .nav{
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:1rem 2rem;
        max-width:1220px;
        margin:0 auto;
      }

      .logo {
        display:flex;
        align-items:center;
        justify-content:center;
        min-height: 44px;
      }

      .site-name {
        color:#fff;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: none;
      }

      .nav-links{
        list-style:none;
        display:flex;
        gap:1.5rem;
        align-items:center;
      }

      .nav-links a{
        color:#fff;
        opacity:0.85;
        font-weight:600;
        font-size:0.9rem;
        letter-spacing:0.04em;
        transition:opacity 0.2s ease, transform 0.2s ease;
      }

      .nav-links a:hover{
        opacity:1;
        transform:translateY(-1px);
      }

      .nav-toggle{
        display:none;
        background:none;
        border:none;
        color:#fff;
        font-size:1.7rem;
        cursor:pointer;
      }

      .hero{
        position:relative;
        min-height:620px;
        display:flex;
        align-items:center;
        justify-content:center;
        background:
          linear-gradient(120deg, rgba(8, 23, 33, 0.76), rgba(17, 39, 60, 0.82)),
          linear-gradient(135deg, #0d2a3d 0%, #153c5c 36%, #111b2a 100%);
        overflow:hidden;
      }

      .hero::before{
        content:"";
        position:absolute;
        inset:0;
        background:
          linear-gradient(135deg, rgba(212,160,23,0.14), transparent 34%),
          repeating-linear-gradient(
            45deg,
            rgba(255,255,255,0.02),
            rgba(255,255,255,0.02) 2px,
            transparent 2px,
            transparent 12px
          );
      }

      .hero-overlay{
        position:absolute;
        inset:0;
        background:radial-gradient(ellipse at top, rgba(212,160,23,0.22), transparent 48%);
      }

      .hero-content{
        position:relative;
        z-index:1;
        text-align:center;
        color:#fff;
        max-width:820px;
        padding:2rem;
      }

      .eyebrow{
        display:inline-block;
        margin-bottom:1rem;
        color:var(--gold-600);
        font-size:0.8rem;
        font-weight:800;
        letter-spacing:0.18em;
        text-transform:uppercase;
      }

      .hero h1{
        font-size:3.5rem;
        font-weight:800;
        line-height:1.08;
        margin-bottom:1.25rem;
        letter-spacing:-0.04em;
      }

      .hero-accent{
        color:var(--gold-600);
      }

      .hero-copy{
        font-size:1.2rem;
        opacity:0.92;
        max-width:680px;
        margin:0 auto 2rem auto;
      }

      .hero-buttons{
        display:flex;
        gap:1rem;
        justify-content:center;
        flex-wrap:wrap;
      }

      .btn{
        display:inline-block;
        padding:0.875rem 2rem;
        border-radius:10px;
        font-weight:700;
        font-size:1rem;
        cursor:pointer;
        transition:transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        border:none;
      }

      .btn-primary{
        background:linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color:#1a1a1a;
        box-shadow:0 10px 24px rgba(212,160,23,0.28);
      }

      .btn-primary:hover{
        background:linear-gradient(135deg, #e7b93f, #d1a02c);
        transform:translateY(-2px);
        box-shadow:0 12px 28px rgba(212,160,23,0.35);
      }

      .btn-outline{
        background:transparent;
        color:#fff;
        border:2px solid rgba(255,255,255,0.45);
      }

      .btn-outline:hover{
        border-color:#fff;
        background:rgba(255,255,255,0.08);
      }

      .btn-full{
        width:100%;
        text-align:center;
      }

      .trust-bar{
        display:flex;
        justify-content:space-around;
        align-items:center;
        padding:2rem 2rem;
        background:linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
        color:#fff;
        flex-wrap:wrap;
        gap:1rem;
      }

      .trust-item{
        text-align:center;
        padding:0.5rem 1rem;
      }

      .trust-item strong{
        display:block;
        font-size:2rem;
        color:var(--gold-600);
        font-weight:800;
      }

      .trust-item span{
        font-size:0.9rem;
        opacity:0.75;
        letter-spacing:0.04em;
      }

      .section{
        padding:5rem 2rem;
        max-width:1200px;
        margin:0 auto;
      }

      .section-alt{
        background:linear-gradient(135deg, #f1efe9, #f8f8f6);
        max-width:100%;
      }

      .section-header{
        text-align:center;
        margin-bottom:3rem;
      }

      .section-tag{
        display:inline-block;
        color:var(--gold-600);
        font-weight:700;
        font-size:0.8rem;
        text-transform:uppercase;
        letter-spacing:0.18em;
        margin-bottom:0.75rem;
      }

      .section-header h2,
      .about-text h2,
      .contact-info-block h2{
        font-size:2.5rem;
        font-weight:800;
        margin-bottom:1rem;
        color:#142e40;
      }

      .section-header p{
        font-size:1.1rem;
        color:var(--muted);
      }

      .service-cards{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
        gap:2rem;
      }

      .service-card{
        background:#fff;
        border:1px solid rgba(20, 46, 64, 0.12);
        border-radius:18px;
        padding:2.5rem 2rem;
        transition:all 0.25s ease;
        position:relative;
        overflow:hidden;
        display:block;
        box-shadow:0 10px 28px rgba(13,29,45,0.05);
      }

      .service-card::before{
        content:"";
        position:absolute;
        top:0;
        left:0;
        right:0;
        height:5px;
        background:linear-gradient(90deg, var(--gold-600), var(--gold-700));
        transform:scaleX(0);
        transition:transform 0.25s ease;
      }

      .service-card:hover{
        transform:translateY(-8px);
        box-shadow:0 18px 44px rgba(13,29,45,0.12);
        border-color:rgba(20,46,64,0.18);
      }

      .service-card:hover::before{
        transform:scaleX(1);
      }

      .service-icon{
        font-size:3rem;
        margin-bottom:1rem;
      }

      .service-card h3{
        font-size:1.5rem;
        margin-bottom:0.75rem;
        font-weight:700;
        color:#173953;
      }

      .service-card p{
        color:#5d6670;
        margin-bottom:1.5rem;
      }

      .service-features{
        list-style:none;
        margin-bottom:1.5rem;
      }

      .service-features li{
        padding:0.2rem 0;
        color:#3d4a55;
        font-size:0.95rem;
      }

      .service-link{
        color:var(--gold-600);
        font-weight:700;
      }

      .service-link:hover{
        color:var(--gold-700);
      }

      .about-container{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:4rem;
        align-items:center;
        max-width:1200px;
        margin:0 auto;
      }

      .about-text p{
        color:#505d68;
        margin-bottom:1rem;
        font-size:1.05rem;
      }

      .about-text .btn{
        margin-top:1rem;
      }

      .about-stats{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:1.5rem;
      }

      .stat-box{
        background:#fff;
        border:1px solid rgba(20, 46, 64, 0.08);
        border-radius:14px;
        padding:2rem 1.5rem;
        text-align:center;
        box-shadow:0 8px 20px rgba(13,29,45,0.05);
      }

      .stat-box strong{
        display:block;
        font-size:1.75rem;
        color:var(--gold-600);
        font-weight:800;
      }

      .stat-box span{
        color:#667280;
        font-size:0.9rem;
      }

      .contact-section{
        max-width:100%;
        background:linear-gradient(135deg, #eef0ed, #f8f8f6);
      }

      .contact-container{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:3rem;
        max-width:1200px;
        margin:0 auto;
      }

      .contact-info-block p{
        color:#5c6873;
        margin-bottom:2rem;
        font-size:1.1rem;
      }

      .contact-details{
        display:flex;
        flex-direction:column;
        gap:1.5rem;
      }

      .contact-item{
        display:flex;
        align-items:flex-start;
        gap:1rem;
      }

      .contact-icon{
        font-size:1.5rem;
        flex-shrink:0;
      }

      .contact-item strong{
        display:block;
        margin-bottom:0.25rem;
        color:#173953;
      }

      .contact-item a,
      .contact-item span{
        color:#576673;
      }

      .contact-item a:hover{
        color:var(--gold-600);
      }

      .contact-form{
        background:#fff;
        border-radius:20px;
        border:1px solid rgba(20,46,64,0.08);
        padding:2.5rem;
        box-shadow:0 12px 30px rgba(13,29,45,0.06);
      }

      .contact-form h3{
        font-size:1.5rem;
        margin-bottom:1.5rem;
        font-weight:700;
        color:#173953;
      }

      .contact-form input,
      .contact-form select,
      .contact-form textarea{
        width:100%;
        padding:0.875rem 1rem;
        border:2px solid #dfe5ea;
        border-radius:10px;
        font-size:1rem;
        font-family:inherit;
        background:#fbfbfb;
      }

      .contact-form input:focus,
      .contact-form select:focus,
      .contact-form textarea:focus{
        outline:none;
        border-color:var(--gold-600);
      }

      .contact-form textarea{
        resize:vertical;
      }

      footer{
        background:linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color:#fff;
        padding:3rem 2rem 2rem;
      }

      .footer-content{
        max-width:1200px;
        margin:0 auto;
        text-align:center;
      }

      .footer-brand {
        display:flex;
        align-items:center;
        justify-content:center;
        margin-bottom:0.75rem;
      }

      .footer-wordmark{
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.02em;
        font-size: 1.15rem;
      }

      .footer-content > p{
        opacity:0.7;
        margin-bottom:1rem;
      }

      .footer-nav{
        display:flex;
        justify-content:center;
        gap:2rem;
        flex-wrap:wrap;
        margin-bottom:1.5rem;
      }

      .footer-nav a {
        opacity:0.8;
        transition:opacity 0.2s ease;
      }

      .footer-nav a:hover{
        opacity:1;
      }

      .license-number{
        margin-top:1rem;
        color:var(--gold-600);
        font-weight:700;
        letter-spacing:0.03em;
      }

      .copyright{
        font-size:0.875rem;
        opacity:0.55;
      }

      @media (max-width: 768px){
        .nav-toggle{display:block;}
        .nav-links{
          display:none;
          position:absolute;
          top:100%;
          left:0;
          right:0;
          background:rgba(15, 29, 43, 0.98);
          flex-direction:column;
          padding:1rem 2rem;
          gap:1rem;
          z-index:10;
        }
        .nav-links.open{display:flex;}
        .hero h1{font-size:2.3rem;}
        .hero p{font-size:1rem;}
        .section-header h2,.about-text h2,.contact-info-block h2{font-size:1.9rem;}
        .about-container,.contact-container{grid-template-columns:1fr;}
        .trust-bar{flex-direction:column;}
        .trust-item{padding:0.5rem 0;}
      }
    </style>
  </body>
</html>
