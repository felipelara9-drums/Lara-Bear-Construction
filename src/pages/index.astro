    <script>
      function initHeroVideoRotation() {
        const frontVideo = document.querySelector(".hero-video-front");
        const kitchenVideo = document.querySelector(".hero-video-kitchen");

        if (!frontVideo || !kitchenVideo) return;

        // Clear an existing timer if the page script is initialized again.
        if (window.heroVideoRotationTimer) {
          window.clearInterval(window.heroVideoRotationTimer);
        }

        const videos = [frontVideo, kitchenVideo];
        let activeIndex = 0;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        // The front video is the initial visible video.
        frontVideo.classList.add("is-active");
        kitchenVideo.classList.remove("is-active");
        frontVideo.play().catch(() => {});

        // Respect reduced-motion preferences by keeping the first video visible.
        if (reducedMotion) return;

        window.heroVideoRotationTimer = window.setInterval(() => {
          const nextIndex = activeIndex === 0 ? 1 : 0;
          const currentVideo = videos[activeIndex];
          const nextVideo = videos[nextIndex];

          // Restart the incoming video for a clean transition.
          try {
            nextVideo.currentTime = 0;
          } catch (error) {
            // The browser may not have loaded enough video data yet.
          }

          nextVideo.play()
            .then(() => {
              nextVideo.classList.add("is-active");
              currentVideo.classList.remove("is-active");
              activeIndex = nextIndex;
            })
            .catch(() => {
              // Keep the current video visible if the next video cannot play.
            });
        }, 10000);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHeroVideoRotation, { once: true });
      } else {
        initHeroVideoRotation();
      }
    </script>

    <script is:inline>
      (() => {
        const form = document.getElementById('homepage-request-form');
        const status = document.getElementById('homepage-request-status');
        if (!form || !status) return;

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector('button[type="submit"]');
          button.disabled = true;
          status.textContent = 'Sending your request...';
          status.className = 'homepage-request-status is-info';

          try {
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());
            payload.access_key = 'PASTE_YOUR_NEW_WEB3FORMS_ACCESS_KEY_HERE';
            payload.subject = 'New Homepage Request - Lara Bear Construction';
            payload.from_name = 'Lara Bear Construction Website';

            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.message || 'Your request could not be sent.');
            }

            status.textContent = 'Thanks! Your request has been sent. We’ll be in touch soon.';
            status.className = 'homepage-request-status is-success';
            form.reset();
          } catch (error) {
            console.error('Homepage request form error:', error);
            status.textContent = 'Sorry, your request could not be sent. Please try again or contact us by phone or email.';
            status.className = 'homepage-request-status is-error';
          } finally {
            button.disabled = false;
          }
        });
      })();
    </script>
  </body>
