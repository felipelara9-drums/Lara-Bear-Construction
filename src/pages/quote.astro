        price: "$15,000 - $30,000",
        scope: [
          "Perform comprehensive site evaluation.",
          "Protect occupied and unaffected areas.",
          "Demolish designated walls, finishes, flooring, and fixtures.",
          "Complete structural modifications as required.",
          "Upgrade electrical, plumbing, and HVAC systems.",
          "Install new drywall and insulation.",
          "Install flooring throughout designated areas.",
          "Install new cabinetry, countertops, fixtures, and finish materials.",
          "Complete painting and trim installation.",
          "Conduct quality control inspections throughout construction.",
          "Perform final punch-list completion and project walkthrough."
        ]
      },
      premium: {
        label: "Premium",
        price: "$30,000+",
        scope: [
          "Conduct site inspection and project planning.",
          "Remove existing materials as required.",
          "Complete framing, drywall, and finish carpentry work.",
          "Upgrade electrical and plumbing systems as needed.",
          "Install flooring, cabinetry, and finish materials.",
          "Complete painting and touch-up work.",
          "Perform final cleaning and quality assurance inspection."
        ]
      }
    }
  },
  kitchen: {
    label: "Kitchen Remodel",
    options: {
      basic: {
        label: "Basic",
        price: "$15,000 - $35,000",
        scope: [
          "Assess damaged structural components.",
          "Develop repair strategy for affected framing and load-bearing elements.",
          "Remove damaged materials.",
          "Repair or replace framing, sheathing, and structural members.",
          "Reinforce affected areas as required by code.",
          "Coordinate inspections where applicable.",
          "Restore interior and exterior finishes impacted by repairs.",
          "Conduct final structural review and project walkthrough."
        ]
      },
      standard: {
        label: "Standard",
        price: "$35,000 - $75,000",
        scope: [
          "Assess fire, smoke, and soot damage.",
          "Remove damaged materials and debris.",
          "Clean affected surfaces using specialized restoration methods.",
          "Deodorize impacted areas using industry-standard techniques.",
          "Repair or replace damaged drywall, insulation, and finishes.",
          "Prime and repaint affected surfaces.",
          "Complete reconstruction and final cleanup activities."
        ]
      },
      premium: {
        label: "Premium",
        price: "$75,000+",
        scope: [
          "Complete tear-out and removal of existing kitchen finishes and fixtures.",
          "Perform structural, plumbing, and electrical upgrades as needed.",
          "Install cabinetry, countertops, and backsplash systems.",
          "Install new flooring, lighting, and ventilation improvements.",
          "Finish drywall, trim, and paint throughout the space.",
