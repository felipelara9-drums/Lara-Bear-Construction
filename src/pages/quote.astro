        --navy-900: #102c40;
        --navy-800: #163d5d;
        --navy-700: #1b4d73;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --text: #1a1a1a;
        --muted: #556274;
        --warm: #f5f1eb;
        --light: #f9f9f7;
        --panel: #ffffff;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: linear-gradient(135deg, #f5f1eb 0%, #f9f9f7 100%);
      }
      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; display: block; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.5);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        max-width: 1220px;
        margin: 0 auto;
      }

      .site-brand {
        color: #fff;
        font-weight: 800;
        font-size: 1.08rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .nav-links {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: #fff;
        opacity: 0.85;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
      }

      .nav-links a.active,
      .nav-links a:hover {
        opacity: 1;
      }

      .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.7rem;
        cursor: pointer;
      }

      .page-hero {
        background: linear-gradient(135deg, rgba(11, 29, 45, 0.8), rgba(22, 61, 93, 0.82));
        padding: 5rem 2rem 4rem;
      }

      .hero-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
        color: #fff;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--gold-600);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .eyebrow-dark {
        color: var(--gold-600);
      }

      .hero-content h1 {
        font-size: clamp(2.3rem, 4vw, 4rem);
        margin-bottom: 1rem;
      }

      .hero-content p {
        max-width: 700px;
        margin: 0 auto;
        font-size: 1.06rem;
        opacity: 0.92;
      }

      .request-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 5rem;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 2rem;
      }

      .panel {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 18px 38px rgba(13, 29, 45, 0.06);
      }

      .request-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .full-width {
        grid-column: 1 / -1;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-weight: 600;
        color: #1d2a36;
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        padding: 0.9rem 1rem;
        border: 2px solid #dde5eb;
        border-radius: 10px;
        background: #fbfbfb;
        color: var(--text);
      }

      textarea {
        resize: vertical;
      }

      select {
        appearance: auto;
        -webkit-appearance: menulist;
        -moz-appearance: menulist;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold-600);
      }

      .btn {
        display: inline-block;
        padding: 0.9rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color: #1a1a1a;
        box-shadow: 0 10px 24px rgba(212, 160, 23, 0.28);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(212, 160, 23, 0.35);
      }

      .btn-full {
        width: 100%;
      }

      .section-tag {
        display: inline-block;
        color: var(--gold-600);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
      }

      .summary-panel {
        align-self: start;
      }

      .summary-panel h2 {
        margin: 0.5rem 0 1.5rem;
        color: #142e40;
        font-size: clamp(1.8rem, 2vw, 2.5rem);
      }

      .summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1rem 1.1rem;
        border-radius: 12px;
        background: #f6f8fa;
        margin-bottom: 1rem;
      }

      .summary-item span {
        color: var(--muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .summary-item strong {
        font-size: 1.4rem;
        color: #122d3d;
      }

      .summary-item.highlight {
        background: linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
      }

      .summary-item.highlight strong,
      .summary-item.highlight span {
        color: #fff;
      }

      .summary-panel p {
        margin-top: 1.25rem;
        color: var(--muted);
        line-height: 1.7;
      }

      .detailed-pricing-section {
        max-width: 1200px;
        margin: 0 auto 5rem;
        padding: 0 2rem;
      }

      .section-header-row {
        margin-bottom: 1.5rem;
      }

      .section-header-row h2 {
        font-size: clamp(2rem, 3vw, 3rem);
        color: #142e40;
      }

      .detailed-pricing-list {
        display: grid;
        gap: 2rem;
      }

      .pricing-group {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        padding: 1.5rem;
        box-shadow: 0 18px 38px rgba(13, 29, 45, 0.06);
      }

      .pricing-group h3 {
        margin-bottom: 1rem;
        font-size: 1.4rem;
        color: #142e40;
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .price-card {
        background: #f8fafb;
        border: 1px solid #dfe8ee;
        border-radius: 16px;
        padding: 1rem;
      }

      .price-card h4 {
        font-size: 1.05rem;
        color: #142e40;
        margin-bottom: 0.5rem;
      }

      .price-range {
        color: var(--gold-700);
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: 0.75rem;
      }

      .price-card ul {
        list-style: disc;
        padding-left: 1.2rem;
        color: var(--muted);
        line-height: 1.7;
      }

      footer {
        background: linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color: #fff;
        padding: 3rem 2rem 2rem;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
      }

      .footer-brand-text {
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer-content > p {
        opacity: 0.7;
        margin-bottom: 1rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .footer-nav a {
        opacity: 0.8;
      }

      .footer-nav a:hover {
        opacity: 1;
      }

      .license-number {
        margin-top: 1rem;
        color: var(--gold-600);
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .copyright {
        font-size: 0.875rem;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        .nav-toggle { display: block; }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(15, 29, 43, 0.98);
          flex-direction: column;
          padding: 1rem 2rem;
          gap: 1rem;
          z-index: 10;
        }
        .nav-links.open { display: flex; }

        .request-layout, .form-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
