      </div>
    </footer>

    <script is:inline define:vars={{ estimateMap, serviceScopeDetails }}>
      document.addEventListener('DOMContentLoaded', () => {
        const projectSelect = document.getElementById('project-type');
        const scopeSelect = document.getElementById('project-scope');
        const summaryProject = document.getElementById('summary-project');
        const summaryScope = document.getElementById('summary-scope');
        const summaryPrice = document.getElementById('summary-price');
        const detailedPricingList = document.getElementById('detailed-pricing-list');
        const scopeDetailPanel = document.getElementById('scope-detail-panel');
        const quoteForm = document.getElementById('quote-form');
        const quoteStatus = document.getElementById('quote-status');

        const params = new URLSearchParams(window.location.search);
        let currentProject = params.get('project') || projectSelect.value || 'waterDamageRestoration';
        let currentScope = params.get('scope');

        function updateScopeOptions(selectedKey) {
          const projectData = estimateMap[selectedKey];
          if (!projectData) return;

          scopeSelect.innerHTML = '';
          const options = projectData.options;
          const optionKeys = Object.keys(options);

          if (!currentScope || !options[currentScope]) {
            currentScope = optionKeys[0];
          }

          optionKeys.forEach((key) => {
            const opt = document.createElement('option');
            opt.value = key;
            opt.textContent = options[key].label;
            if (key === currentScope) opt.selected = true;
            scopeSelect.appendChild(opt);
          });
        }

        function renderPricingGuide(projectKey) {
          const projectData = estimateMap[projectKey];
          if (!projectData || !detailedPricingList) return;

          detailedPricingList.innerHTML = Object.entries(projectData.options)
            .map(([key, opt]) => `
              <div class="pricing-card ${key === currentScope ? 'active' : ''}">
                <div class="pricing-header">
                  <h3>${opt.label}</h3>
                  <div class="pricing-badge">${opt.price}</div>
                </div>
                <ul class="pricing-checklist">
                  ${opt.scope.map(s => `<li>${s}</li>`).join('')}
                </ul>
              </div>
            `).join('');
        }

        function renderScopeBreakdown(projectKey) {
          const details = serviceScopeDetails[projectKey];
          if (!details || !scopeDetailPanel) return;

          scopeDetailPanel.innerHTML = details.map((tier) => `
            <div class="scope-tier-card">
              <div class="scope-tier-header">
                <div>
                  <h3>${tier.title}</h3>
                  ${tier.examples?.length ? `<p class="scope-examples">Typical: ${tier.examples.join(', ')}</p>` : ''}
                </div>
                <div class="tier-price">${tier.price}</div>
              </div>
              <ul class="scope-items-list">
                ${tier.items.map(i => `<li>${i}</li>`).join('')}
              </ul>
            </div>
          `).join('');
        }

        function updateSummary() {
          const projectData = estimateMap[currentProject];
          if (!projectData) return;

          summaryProject.textContent = projectData.label;

          const scopeData = projectData.options[currentScope];
          if (scopeData) {
            summaryScope.textContent = scopeData.label;
            summaryPrice.textContent = scopeData.price;
          }
        }

        function refreshAll() {
          projectSelect.value = currentProject;
          updateScopeOptions(currentProject);
          updateSummary();
          renderPricingGuide(currentProject);
          renderScopeBreakdown(currentProject);
        }

        projectSelect.addEventListener('change', (e) => {
          currentProject = e.target.value;
          currentScope = null;
          refreshAll();
        });

        scopeSelect.addEventListener('change', (e) => {
          currentScope = e.target.value;
          updateSummary();
          renderPricingGuide(currentProject);
        });

quoteForm?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const submitButton = quoteForm.querySelector(
    'button[type="submit"]'
  );

  submitButton.disabled = true;
  quoteStatus.textContent = 'Sending your quote request...';
  quoteStatus.className = 'form-status info';

  try {
    const formData = new FormData(quoteForm);

    // Text-only submission; photo uploads require Web3Forms Pro.
    formData.delete('images');

    formData.append(
      'access_key',
      'bbab1d36-0bb6-4ca5-9c2a-30c8219dc35d'
    );
    formData.append(
      'subject',
      'New Quote Request - Lara Bear Construction'
    );
    formData.append('from_name', 'Lara Bear Construction Website');

    const response = await fetch(
      'https://api.web3forms.com/submit',
      {
        method: 'POST',
        body: formData
      }
    );

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.message || 'The request could not be sent.'
      );
    }

    quoteStatus.textContent =
      'Thank you! Your quote request was sent successfully. We will contact you soon.';
    quoteStatus.className = 'form-status success';

    quoteForm.reset();
    currentScope = null;
    refreshAll();
  } catch (error) {
    console.error('Quote submission error:', error);
    quoteStatus.textContent =
      'Sorry, your request could not be sent. Please try again or contact us by email.';
    quoteStatus.className = 'form-status error';
 
  } finally {
    submitButton.disabled = false;
  }
});

refreshAll();
});
</script>


