---
const companyName = "Lara Bear Construction";
const email = "larabearco@outlook.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Get a free project estimate from Lara Bear Construction. Answer a few quick questions and we’ll send you a detailed quote." />
    <title>Free Quote | {companyName}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo" aria-label="Lara Bear Construction home">
          <img src="/logo.svg" alt="Lara Bear Construction logo" class="brand-logo" />
        </a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote">Free Quote</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main class="page-shell">
      <section class="estimator-card">
        <div class="estimator-header">
          <p class="eyebrow">Free Project Estimator</p>
          <h1>What service do you need?</h1>
        </div>

        <form id="quoteForm" class="quote-form">
          <label>
            <span>Service</span>
            <select id="service">
              <option value="water-damage">Water Damage</option>
              <option value="kitchen-remodel">Kitchen Remodel</option>
              <option value="bathroom-remodel">Bathroom Remodel</option>
              <option value="whole-home">Whole-Home Renovation</option>
              <option value="fire-smoke">Fire & Smoke Damage</option>
              <option value="storm-damage">Storm Damage Repair</option>
            </select>
          </label>

          <label>
            <span>Project Size</span>
            <select id="size">
              <option value="500">500-1,000 sq ft</option>
              <option value="1000">1,000-2,000 sq ft</option>
              <option value="2000">2,000-3,000 sq ft</option>
              <option value="3000">3,000+ sq ft</option>
            </select>
          </label>

          <label>
            <span>Insurance Claim?</span>
            <select id="insurance">
              <option value="yes">Yes</option>
              <option value="no">No</option>
            </select>
          </label>

          <div class="estimate-panel">
            <div class="estimate-label">Estimated Range</div>
            <div id="estimateValue" class="estimate-value">$7,500 - $15,000</div>
            <p id="estimateNote">
              Pricing varies based on materials, damage severity, accessibility, and inspection results.
            </p>
          </div>

          <button type="submit" class="btn btn-primary">Get My Detailed Quote</button>
        </form>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/logo.svg" alt="Lara Bear Construction logo" class="brand-logo-footer" />
        </div>
        <p>Restoration / Remodeling</p>
        <nav class="footer-nav">
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Free Quote</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>
        <p class="copyright">&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      </div>
    </footer>

    <script is:inline>
      const serviceSelect = document.getElementById('service');
      const sizeSelect = document.getElementById('size');
      const insuranceSelect = document.getElementById('insurance');
      const estimateValue = document.getElementById('estimateValue');
      const estimateNote = document.getElementById('estimateNote');
      const quoteForm = document.getElementById('quoteForm');

      const serviceBase = {
        'water-damage': { min: 7500, max: 15000 },
        'kitchen-remodel': { min: 18000, max: 42000 },
        'bathroom-remodel': { min: 12000, max: 26000 },
        'whole-home': { min: 42000, max: 125000 },
        'fire-smoke': { min: 10000, max: 30000 },
        'storm-damage': { min: 9000, max: 25000 }
      };

      const sizeFactor = {
        '500': 0.85,
        '1000': 1,
        '2000': 1.35,
        '3000': 1.7
      };

      function formatMoney(value) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0
        }).format(value);
      }

      function calculateEstimate() {
        const service = serviceSelect.value;
        const size = Number(sizeSelect.value);
        const insurance = insuranceSelect.value;
        const range = serviceBase[service];

        const multiplier = sizeFactor[String(size)] || 1;
        const low = Math.round(range.min * multiplier * (insurance === 'yes' ? 0.92 : 1));
        const high = Math.round(range.max * multiplier * (insurance === 'yes' ? 0.96 : 1.04));

        estimateValue.textContent = `${formatMoney(low)} - ${formatMoney(high)}`;
        estimateNote.textContent = 'Pricing varies based on materials, damage severity, accessibility, and inspection results.';
      }

      [serviceSelect, sizeSelect, insuranceSelect].forEach((field) => {
        field.addEventListener('change', calculateEstimate);
      });

      quoteForm.addEventListener('submit', (event) => {
        event.preventDefault();

        const service = serviceSelect.options[serviceSelect.selectedIndex].text;
        const size = sizeSelect.options[sizeSelect.selectedIndex].text;
        const insurance = insuranceSelect.options[insuranceSelect.selectedIndex].text;
        const estimate = estimateValue.textContent;

        const subject = encodeURIComponent(`Free Quote Request - ${service}`);
        const body = encodeURIComponent(
          `Service: ${service}\n` +
          `Project Size: ${size}\n` +
          `Insurance Claim: ${insurance}\n` +
          `Estimated Range: ${estimate}\n\n` +
          'Please send me a detailed quote and next steps.'
        );

        window.location.href = `mailto:${"larabearco@outlook.com"}?subject=${subject}&body=${body}`;
      });

      calculateEstimate();
    </script>

    <style is:global>
      :root {
        --navy-950: #0b1d2d;
        --navy-900: #102c40;
        --navy-800: #163d5d;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --panel: #ffffff;
        --text: #1a1a1a;
        --muted: #556274;
        --bg: #f6f5f1;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.6;
        background: linear-gradient(180deg, #f5f1eb 0%, #f7f7f7 100%);
        color: var(--text);
      }
      a { text-decoration: none; color: inherit; }
      img { display: block; max-width: 100%; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.45);
      }

      .nav {
        max-width: 1220px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand-logo {
        display: block;
        width: clamp(200px, 26vw, 420px);
        height: auto;
        object-fit: contain;
      }

      .brand-logo-footer {
        display: block;
        width: clamp(150px, 18vw, 300px);
        height: auto;
        object-fit: contain;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        align-items: center;
      }

      .nav-links a {
        color: #fff;
        opacity: 0.85;
        font-weight: 600;
        font-size: 0.92rem;
        letter-spacing: 0.04em;
      }

      .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: white;
        font-size: 1.7rem;
        cursor: pointer;
      }

      .page-shell {
        min-height: calc(100vh - 200px);
        display: grid;
        place-items: center;
        padding: 4rem 1rem;
      }

      .estimator-card {
        width: min(700px, 100%);
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        box-shadow: 0 22px 50px rgba(15, 29, 43, 0.08);
        padding: 2.25rem 2rem 2rem;
      }

      .eyebrow {
        color: var(--gold-600);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 0.75rem;
      }

      .estimator-header h1 {
        font-size: clamp(2.1rem, 4vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        color: #122b3d;
        margin-bottom: 1.5rem;
      }

      .quote-form {
        display: grid;
        gap: 1.2rem;
      }

      .quote-form label {
        display: grid;
        gap: 0.55rem;
        font-weight: 600;
        color: #1b2d3d;
      }

      .quote-form span {
        font-size: 0.98rem;
      }

      select {
        width: 100%;
        appearance: none;
        background: #fdfdfd;
        border: 2px solid #dde3e8;
        border-radius: 12px;
        padding: 0.95rem 1rem;
        color: var(--text);
        font-size: 1rem;
        font-family: inherit;
        background-image: linear-gradient(45deg, transparent 50%, #556274 50%), linear-gradient(135deg, #556274 50%, transparent 50%);
        background-position: calc(100% - 19px) calc(50% - 3px), calc(100% - 12px) calc(50% - 3px);
        background-size: 7px 7px, 7px 7px;
        background-repeat: no-repeat;
      }

      select:focus {
        outline: none;
        border-color: var(--gold-600);
        box-shadow: 0 0 0 3px rgba(212, 160, 23, 0.14);
      }

      .estimate-panel {
        margin-top: 0.5rem;
        border-radius: 18px;
        background: linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
        color: white;
        padding: 1.5rem 1.25rem;
      }

      .estimate-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        opacity: 0.75;
        margin-bottom: 0.3rem;
      }

      .estimate-value {
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        line-height: 1.1;
        color: var(--gold-600);
      }

      .estimate-panel p {
        margin-top: 0.8rem;
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .btn {
        display: inline-block;
        width: 100%;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        border: none;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color: #1a1a1a;
        box-shadow: 0 10px 24px rgba(212, 160, 23, 0.2);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(212, 160, 23, 0.28);
      }

      footer {
        background: linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color: white;
        padding: 3rem 2rem 2rem;
      }

      .footer-content {
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
      }

      .footer-brand {
        display: flex;
        justify-content: center;
        margin-bottom: 0.75rem;
      }

      .footer-content > p {
        opacity: 0.75;
        margin-bottom: 1rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .footer-nav a { opacity: 0.8; }
      .copyright { font-size: 0.875rem; opacity: 0.55; }

      @media (max-width: 768px) {
        .nav-toggle { display: block; }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(15, 29, 43, 0.98);
          flex-direction: column;
          padding: 1rem 2rem;
          gap: 1rem;
        }
        .nav-links.open { display: flex; }
        .estimator-card { padding: 1.5rem 1.15rem; }
      }
    </style>
  </body>
</html>
