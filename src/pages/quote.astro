const selectedScopeLabel = estimateMap[projectParam]?.options?.[scopeParam]?.label || 'Minor Water Damage';
const selectedPrice = estimateMap[projectParam]?.options?.[scopeParam]?.price || '$1,500 - $5,000';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Detailed quote request and pricing guide for Lara Bear Construction restoration and remodeling services." />
    <title>Detailed Quote | Lara Bear Construction</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="site-brand" aria-label="Lara Bear Construction home">Lara Bear Construction</a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote" class="active">Detailed Quote</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="page-hero">
        <div class="hero-content">
          <p class="eyebrow">Detailed quote request</p>
          <h1>Tell us about your project</h1>
          <p>We’ll review your restoration or remodeling project and follow up with a personalized estimate and scope of work.</p>
        </div>
      </section>

      <section class="request-layout">
        <div class="request-panel panel">
          <form class="request-form" onsubmit="event.preventDefault(); const form = event.currentTarget; const project = form.querySelector('#project-type').value; const scope = form.querySelector('#project-scope').value; const insurance = form.querySelector('#insurance-job').value === 'yes' ? 'Yes' : 'No'; const projectLabel = projectValues[project]?.label || 'Project'; const scopeLabel = projectValues[project]?.options?.[scope]?.label || 'Project Scope'; const subject = encodeURIComponent('Detailed Quote Request - ' + projectLabel); const body = encodeURIComponent('Project Type: ' + projectLabel + '\nScope of Work: ' + scopeLabel + '\nInsurance Job: ' + insurance + '\n\nPlease send me a detailed quote and next steps.'); window.location.href = `mailto:larabearco@outlook.com?subject=${subject}&body=${body}`;">
            <div class="form-grid">
              <label>
                Full name
                <input type="text" name="name" placeholder="Your Name" required />
              </label>

              <label>
                Email address
                <input type="email" name="email" placeholder="you@example.com" required />
              </label>

              <label>
                Phone number
                <input type="tel" name="phone" placeholder="(555) 123-4567" />
              </label>

              <label>
                Project type
                <select id="project-type" name="projectType">
                  <option value="waterDamageRestoration" selected={projectParam === 'waterDamageRestoration'}>Water Damage Restoration</option>
                  <option value="waterDamageReconstruction" selected={projectParam === 'waterDamageReconstruction'}>Water Damage Reconstruction</option>
                  <option value="bathroom" selected={projectParam === 'bathroom'}>Bathroom Remodel</option>
                  <option value="kitchen" selected={projectParam === 'kitchen'}>Kitchen Remodel</option>
                  <option value="generalRemodeling" selected={projectParam === 'generalRemodeling'}>General Remodeling</option>
                  <option value="fire" selected={projectParam === 'fire'}>Fire & Smoke Damage Repair</option>
                  <option value="structural" selected={projectParam === 'structural'}>Structural Damage Repair</option>
                </select>
              </label>

              <label>
                Scope of work
                <select id="project-scope" name="scope">
                  <option value="" disabled selected={!scopeParam}>Select scope</option>
                </select>
              </label>

              <label>
                Insurance job?
                <select id="insurance-job" name="insuranceJob">
                  <option value="yes">Yes</option>
                  <option value="no" selected>No</option>
                </select>
              </label>

              <label>
                Service area
                <input type="text" name="location" placeholder="City / Neighborhood" />
              </label>

              <label class="full-width">
                Project details
                <textarea name="details" rows="6" placeholder="Tell us about the project, timeline, and any concerns"></textarea>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Send Request</button>
          </form>
        </div>

        <aside class="summary-panel panel">
          <span class="section-tag">Selected estimate</span>
          <h2>{selectedProjectLabel}</h2>
          <div class="summary-item">
            <span>Scope</span>
            <strong id="summary-scope">{selectedScopeLabel}</strong>
          </div>
          <div class="summary-item highlight">
            <span>Estimated range</span>
            <strong id="summary-price">{selectedPrice}</strong>
          </div>
          <div class="summary-item">
            <span>Insurance job</span>
            <strong id="summary-insurance">No</strong>
          </div>
          <p>
            This estimate is a starting point for planning. Final pricing depends on site conditions, materials, access, code requirements, and project details.
          </p>
        </aside>
      </section>

      <section class="detailed-pricing-section">
        <div class="section-header-row">
          <p class="eyebrow eyebrow-dark">Detailed pricing guide</p>
          <h2>Scope of work and pricing</h2>
        </div>

        <div id="detailed-pricing-list" class="detailed-pricing-list"></div>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-brand-text">Lara Bear Construction</span>
        </div>
        <p>Restoration / Remodeling</p>

        <nav class="footer-nav">
          <a href="/">Home</a>
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Detailed Quote</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <p class="license-number">CSLB License #1159060</p>
        <p class="copyright">&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      </div>
    </footer>

