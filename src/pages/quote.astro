        kitchen: { label: 'Kitchen Remodel', options: { basic: { label: 'Basic', price: '$20,000 - $45,000' }, midRange: { label: 'Mid-Range', price: '$45,000 - $85,000' }, highEnd: { label: 'High-End', price: '$85,000 - $200,000+' } } },
