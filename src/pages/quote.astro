---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Free quote calculator for Lara Bear Construction restoration and remodeling services." />
    <title>Free Quote | Lara Bear Construction</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="site-brand" aria-label="Lara Bear Construction home">Lara Bear Construction</a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote" class="active">Free Quote</a></li>
          <li><a href="/quote-request">Detailed Quote</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Free estimate</p>
          <h1>Get your project priced in minutes</h1>
          <p class="hero-copy">Tell us a few details and we’ll estimate what your restoration or remodeling project may cost in the Sacramento / Northern California market.</p>
        </div>
      </section>

      <section class="quote-layout">
        <div class="calculator panel">
          <div class="panel-header">
            <span class="section-tag">Quote calculator</span>
            <h2>Estimate your project</h2>
          </div>

          <div class="calculator-grid">
            <label>
              Project type
              <select id="project-type" aria-label="Project type">
                <option value="water">Water Damage Restoration</option>
                <option value="bathroom">Bathroom Remodel</option>
                <option value="kitchen">Kitchen Remodel</option>
                <option value="general">General Remodeling</option>
                <option value="fire">Fire & Smoke Damage Repair</option>
                <option value="structural">Structural Damage Repair</option>
              </select>
            </label>

            <label>
              Scope
              <select id="project-scope" aria-label="Project scope"></select>
            </label>
          </div>

          <div class="estimate-box">
            <span>Estimated range</span>
            <strong id="estimate-total">$1,500 - $5,000</strong>
          </div>

          <a href="/quote-request?project=water&scope=minor" class="btn btn-primary btn-full btn-quote" id="detailed-quote-link">
            GET MY DETAILED QUOTE
          </a>

          <p class="disclaimer">
            These estimates are provided for budgeting purposes only. Final pricing depends on site conditions, material selections, accessibility, permit requirements, and project scope. Labor rates and material pricing are based on the 2026 California market, with emphasis on the Sacramento / Northern California region.
          </p>
        </div>

        <div class="contact-panel panel">
          <div class="panel-header">
            <span class="section-tag">Project work scope</span>
            <h2 id="selected-project-label">Water Damage Restoration</h2>
          </div>

          <div class="selected-scope-summary">
            <div class="scope-price-row">
              <span>Selected scope</span>
              <strong id="selected-scope-name">Minor Water Damage</strong>
            </div>

            <div class="scope-price-row highlight">
              <span>Estimated range</span>
              <strong id="selected-price">$1,500 - $5,000</strong>
            </div>
          </div>

          <ul id="scope-list" class="scope-list">
            <li>Water extraction</li>
            <li>Moisture detection</li>
            <li>Drying equipment setup</li>
            <li>Minor drywall removal</li>
            <li>Sanitization</li>
          </ul>

          <div class="terms-block">
            <h3>Exclusions</h3>
            <ul>
              <li>Unforeseen structural deficiencies.</li>
              <li>Hazardous material abatement unless specifically included.</li>
              <li>Permit fees unless otherwise noted.</li>
              <li>Engineering services unless otherwise specified.</li>
              <li>Customer-requested changes after project commencement.</li>
            </ul>
          </div>

          <div class="terms-block">
            <h3>Assumptions</h3>
            <ul>
              <li>Work will be completed during normal business hours.</li>
              <li>Site access will be available throughout construction.</li>
              <li>Existing utilities are functional unless otherwise noted.</li>
            </ul>
          </div>

          <div class="terms-block">
            <h3>Warranty</h3>
            <p>All workmanship is backed by Lara Bear Construction's workmanship warranty. Manufacturer warranties apply to installed products and materials.</p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-brand-text">Lara Bear Construction</span>
        </div>
        <p>Restoration / Remodeling</p>

        <nav class="footer-nav">
          <a href="/">Home</a>
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Free Quote</a>
          <a href="/quote-request">Detailed Quote</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <p class="license-number">CSLB License #1159060</p>
        <p class="copyright">&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const projectType = document.getElementById('project-type');
        const projectScope = document.getElementById('project-scope');
        const estimateTotal = document.getElementById('estimate-total');
        const selectedProjectLabel = document.getElementById('selected-project-label');
        const selectedScopeName = document.getElementById('selected-scope-name');
        const selectedPrice = document.getElementById('selected-price');
        const scopeList = document.getElementById('scope-list');
        const detailedQuoteLink = document.getElementById('detailed-quote-link');

        function syncScopeOptions() {
          const selectedProjectKey = projectType.value;
          const currentProject = estimateMap[selectedProjectKey];
          const entries = Object.entries(currentProject.options);

          projectScope.innerHTML = entries
            .map(([key, value]) => `<option value="${key}">${value.label}</option>`)
            .join('');

          const firstKey = entries[0]?.[0];
          if (firstKey) projectScope.value = firstKey;

          updateEstimate();
        }

        function updateEstimate() {
          const selectedProjectKey = projectType.value;
          const selectedScopeKey = projectScope.value;
          const project = estimateMap[selectedProjectKey];
          const choice = project.options[selectedScopeKey];

          if (!choice) return;

          estimateTotal.textContent = choice.price;
          selectedProjectLabel.textContent = project.label;
          selectedScopeName.textContent = choice.label;
          selectedPrice.textContent = choice.price;
          scopeList.innerHTML = choice.scope.map((item) => `<li>${item}</li>`).join('');
          detailedQuoteLink.href = `/quote-request?project=${encodeURIComponent(selectedProjectKey)}&scope=${encodeURIComponent(selectedScopeKey)}`;
        }

        projectType.addEventListener('change', syncScopeOptions);
        projectScope.addEventListener('change', updateEstimate);

        syncScopeOptions();
      });
    </script>

    <style is:global>
      :root {
        --navy-950: #0b1d2d;
        --navy-900: #102c40;
        --navy-800: #163d5d;
        --navy-700: #1b4d73;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --text: #1a1a1a;
        --muted: #556274;
        --warm: #f5f1eb;
        --light: #f9f9f7;
        --panel: #ffffff;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: linear-gradient(135deg, #f5f1eb 0%, #f9f9f7 100%);
      }
      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; display: block; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.5);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        max-width: 1220px;
        margin: 0 auto;
      }

      .site-brand {
        color: #fff;
        font-weight: 800;
        font-size: 1.08rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .nav-links {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: #fff;
        opacity: 0.85;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
      }

      .nav-links a.active,
      .nav-links a:hover {
        opacity: 1;
      }

      .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.7rem;
        cursor: pointer;
      }

      .hero {
        background: linear-gradient(120deg, rgba(8, 23, 33, 0.76), rgba(17, 39, 60, 0.82)), linear-gradient(135deg, #0d2a3d 0%, #153c5c 36%, #111b2a 100%);
        padding: 5rem 2rem 4rem;
      }

      .hero-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
        color: #fff;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--gold-600);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.04em;
        margin-bottom: 1rem;
      }

      .hero-copy {
        max-width: 700px;
        margin: 0 auto;
        font-size: 1.1rem;
        opacity: 0.92;
      }

      .quote-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 5rem;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 2rem;
      }

      .panel {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 18px 38px rgba(13, 29, 45, 0.06);
      }

      .panel-header h2 {
        font-size: clamp(1.8rem, 2vw, 2.5rem);
        color: #142e40;
        margin-top: 0.25rem;
      }

      .section-tag {
        display: inline-block;
        color: var(--gold-600);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
      }

      .calculator-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
        margin-top: 2rem;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-weight: 600;
        color: #1d2a36;
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        padding: 0.9rem 1rem;
        border: 2px solid #dde5eb;
        border-radius: 10px;
        background: #fbfbfb;
        color: var(--text);
      }

      select {
        appearance: auto;
        -webkit-appearance: menulist;
        -moz-appearance: menulist;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold-600);
      }

      .estimate-box {
        margin-top: 2rem;
        background: linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
        border-radius: 16px;
        color: white;
        padding: 1.5rem 1.25rem;
      }

      .estimate-box span {
        display: block;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        opacity: 0.7;
      }

      .estimate-box strong {
        display: block;
        font-size: clamp(1.8rem, 2vw, 2.7rem);
        margin: 0.5rem 0;
        color: #f8d36a;
      }

      .selected-scope-summary {
        margin-top: 1.5rem;
      }

      .scope-price-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        padding: 0.9rem 1rem;
        border-radius: 12px;
        background: #f5f7fa;
        margin-bottom: 0.75rem;
      }

      .scope-price-row span {
        color: var(--muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .scope-price-row strong {
        color: #122d3d;
        font-size: 1.2rem;
      }

      .scope-price-row.highlight {
        background: linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
      }

      .scope-price-row.highlight span,
      .scope-price-row.highlight strong {
        color: #fff;
      }

      .scope-list {
        list-style: none;
        display: grid;
        gap: 0.65rem;
        margin-top: 1rem;
        padding-left: 0;
      }

      .scope-list li {
        position: relative;
        padding-left: 1.25rem;
        line-height: 1.6;
        color: var(--text);
      }

      .scope-list li::before {
        content: "•";
        position: absolute;
        left: 0;
        top: 0;
        color: var(--gold-600);
        font-weight: 800;
      }

      .terms-block {
        margin-top: 1.5rem;
      }

      .terms-block h3 {
        font-size: 1.02rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #142e40;
        margin-bottom: 0.7rem;
      }

      .terms-block ul {
        list-style: disc;
        padding-left: 1.2rem;
        color: var(--muted);
        line-height: 1.7;
      }

      .terms-block p {
        color: var(--muted);
        line-height: 1.7;
      }

      .btn {
        display: inline-block;
        padding: 0.9rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color: #1a1a1a;
        box-shadow: 0 10px 24px rgba(212, 160, 23, 0.28);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(212, 160, 23, 0.35);
      }

      .btn-full {
        width: 100%;
        text-align: center;
        margin-top: 1.25rem;
      }

      .btn-quote {
        margin-top: 1.5rem;
      }

      .disclaimer {
        margin-top: 1.25rem;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.6;
      }

      footer {
        background: linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color: #fff;
        padding: 3rem 2rem 2rem;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
      }

      .footer-brand-text {
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer-content > p {
        opacity: 0.7;
        margin-bottom: 1rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .footer-nav a {
        opacity: 0.8;
      }

      .footer-nav a:hover {
        opacity: 1;
      }

      .license-number {
        margin-top: 1rem;
        color: var(--gold-600);
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .copyright {
        font-size: 0.875rem;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        .nav-toggle { display: block; }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(15, 29, 43, 0.98);
          flex-direction: column;
          padding: 1rem 2rem;
          gap: 1rem;
          z-index: 10;
        }
        .nav-links.open { display: flex; }

        .quote-layout {
          grid-template-columns: 1fr;
        }

        .calculator-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
