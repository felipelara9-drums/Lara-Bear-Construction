const email = "larabearco@outlook.com";
const phone = "559-892-6331";
const phoneClean = "5598926331";

const estimateMap = {
  water: {
    label: "Water Damage",
    options: {
      small: {
        label: "Small Area",
        price: "$1,500 - $4,000",
        scope: [
          "Perform on-site inspection and moisture assessment.",
          "Identify affected building materials and water intrusion sources.",
          "Extract standing water using commercial-grade equipment.",
          "Deploy air movers and dehumidifiers to stabilize the affected areas.",
          "Monitor moisture levels throughout the drying process.",
          "Remove and dispose of non-salvageable materials as needed.",
