    options: {
      localized: {
        label: "Localized Structural Repair",
        price: "$5,000 - $25,000",
        scope: [
          "Structural assessment",
          "Localized framing repair",
          "Material replacement",
          "Code-compliance review"
        ]
      },
      major: {
        label: "Major Structural Repair",
        price: "$25,000 - $100,000+",
        scope: [
          "Framing and load-bearing repairs",
          "Sheathing replacement",
          "Structural reinforcement",
          "Finish restoration"
        ]
      }
    }
  }
};

