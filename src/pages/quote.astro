---
export const prerender = true;

const companyName = "Lara Bear Construction";
const email = "larabearco@outlook.com";
const phone = "559-892-6331";
const phoneClean = "5598926331";

const estimateMap = {
  waterDamageRestoration: {
    label: "Water Damage Restoration",
    options: {
      minor: {
        label: "Minor Water Damage",
        price: "$1,500 - $5,000",
        scope: [
          "Water extraction",
          "Moisture detection",
          "Drying equipment setup",
          "Minor drywall removal",
          "Sanitization"
        ]
      },
      moderate: {
        label: "Moderate Water Damage",
        price: "$5,000 - $15,000",
        scope: [
          "Water extraction",
          "Drying and dehumidification",
          "Drywall replacement",
          "Baseboard replacement",
          "Flooring repairs",
          "Paint touch-up"
        ]
      },
      major: {
        label: "Major Water Damage",
        price: "$15,000 - $50,000+",
        scope: [
          "Emergency mitigation",
          "Demolition of affected areas",
          "Structural drying",
          "Flooring replacement",
          "Cabinet replacement",
          "Interior reconstruction"
        ]
      }
    }
  },
  waterDamageReconstruction: {
    label: "Water Damage Reconstruction",
    options: {
      singleRoom: {
        label: "Single Room",
        price: "$5,000 - $12,000",
        scope: [
          "Drywall",
          "Paint",
          "Flooring",
          "Trim installation"
        ]
      },
      multipleRooms: {
        label: "Multiple Rooms",
        price: "$12,000 - $35,000",
        scope: [
          "Flooring replacement",
          "Wall reconstruction",
          "Interior painting",
          "Finish carpentry"
        ]
      },
      wholeHome: {
        label: "Whole-Home Restoration",
        price: "$35,000 - $150,000+",
        scope: [
          "Whole-home water mitigation",
          "Interior reconstruction",
          "Finish replacement",
          "Cabinet and flooring restoration"
        ]
      }
    }
  },
  fire: {
    label: "Fire & Smoke Damage Repair",
    options: {
      minor: {
        label: "Minor",
        price: "$3,000 - $15,000",
        scope: [
          "Smoke and soot assessment",
          "Surface cleaning",
          "Odor mitigation",
          "Minor finish repairs"
        ]
      },
      moderate: {
        label: "Moderate",
        price: "$15,000 - $50,000",
        scope: [
          "Interior cleaning",
          "Debris removal",
          "Repair of damaged drywall and finishes",
          "Odor remediation"
        ]
      },
      severe: {
        label: "Severe",
        price: "$50,000 - $250,000+",
        scope: [
          "Extensive material removal",
          "Deep cleaning and deodorization",
          "Reconstruction of affected rooms",
          "Full restoration coordination"
        ]
      }
    }
  },
  structural: {
    label: "Structural Damage Repair",
    options: {
      localized: {
        label: "Localized Structural Repair",
        price: "$5,000 - $25,000",
        scope: [
          "Structural assessment",
          "Localized framing repair",
          "Material replacement",
          "Code-compliance review"
        ]
      },
      major: {
        label: "Major Structural Repair",
        price: "$25,000 - $100,000+",
        scope: [
          "Framing and load-bearing repairs",
          "Sheathing replacement",
          "Structural reinforcement",
          "Finish restoration"
        ]
      }
    }
  }
};

const projectParam = Astro.url.searchParams.get('project') || 'waterDamageRestoration';
const scopeParam = Astro.url.searchParams.get('scope') || Object.keys(estimateMap[projectParam]?.options || {})[0];
const selectedProjectLabel = estimateMap[projectParam]?.label || 'Water Damage Restoration';
const selectedScopeLabel = estimateMap[projectParam]?.options?.[scopeParam]?.label || 'Minor Water Damage';
const selectedPrice = estimateMap[projectParam]?.options?.[scopeParam]?.price || '$1,500 - $5,000';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Detailed quote request and pricing guide for Lara Bear Construction restoration and remodeling services." />
    <title>Detailed Quote | Lara Bear Construction</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="site-brand" aria-label="Lara Bear Construction home">Lara Bear Construction</a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote" class="active">Detailed Quote</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="page-hero">
        <div class="hero-content">
          <p class="eyebrow">Detailed quote request</p>
          <h1>Tell us about your project</h1>
          <p>We’ll review your restoration or remodeling project and follow up with a personalized estimate and scope of work.</p>
        </div>
      </section>

      <section class="request-layout">
        <div class="request-panel panel">
          <form id="quote-form" class="request-form" enctype="multipart/form-data">
            <div class="form-grid">
              <label>
                Full name
                <input type="text" name="name" placeholder="Your Name" required />
              </label>

              <label>
                Email address
                <input type="email" name="email" placeholder="you@example.com" required />
              </label>

              <label>
                Phone number
                <input type="tel" name="phone" placeholder="(555) 123-4567" />
              </label>

              <label>
                Project type
                <select id="project-type" name="projectType">
                  <option value="waterDamageRestoration" selected={projectParam === 'waterDamageRestoration'}>Water Damage Restoration</option>
                  <option value="waterDamageReconstruction" selected={projectParam === 'waterDamageReconstruction'}>Water Damage Reconstruction</option>
                  <option value="fire" selected={projectParam === 'fire'}>Fire & Smoke Damage Repair</option>
                  <option value="structural" selected={projectParam === 'structural'}>Structural Damage Repair</option>
                </select>
              </label>

              <label>
                Scope of work
                <select id="project-scope" name="scope">
                  <option value="" disabled selected={!scopeParam}>Select scope</option>
                </select>
              </label>

              <label>
                Service area
                <input type="text" name="location" placeholder="City / Neighborhood" />
              </label>

              <label class="full-width">
                Project details
                <textarea name="details" rows="6" placeholder="Tell us about the project, timeline, and any concerns"></textarea>
              </label>

              <label class="full-width upload-field">
                Upload project photos
                <input type="file" name="images" accept="image/*" multiple />
                <small>Attach before-and-after photos, damage photos, or room images.</small>
              </label>
            </div>

            <div id="quote-status" class="form-status" aria-live="polite"></div>
            <button type="submit" class="btn btn-primary btn-full">Submit Quote Request</button>
          </form>
        </div>

        <aside class="summary-panel panel">
          <span class="section-tag">Selected estimate</span>
          <h2>{selectedProjectLabel}</h2>
          <div class="summary-item">
            <span>Scope</span>
            <strong id="summary-scope">{selectedScopeLabel}</strong>
          </div>
          <div class="summary-item highlight">
            <span>Estimated range</span>
            <strong id="summary-price">{selectedPrice}</strong>
          </div>
          <p>
            This estimate is a starting point for planning. Final pricing depends on site conditions, materials, access, code requirements, and project details.
          </p>
        </aside>
      </section>

      <section class="detailed-pricing-section">
        <div class="section-header-row">
          <p class="eyebrow eyebrow-dark">Detailed pricing guide</p>
          <h2>Scope of work and pricing</h2>
        </div>

        <div id="detailed-pricing-list" class="detailed-pricing-list"></div>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-brand-text">Lara Bear Construction</span>
        </div>
        <p>Restoration / Remodeling</p>

        <nav class="footer-nav">
          <a href="/">Home</a>
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Detailed Quote</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <p class="license-number">CSLB License #1159060</p>
        <p class="copyright">&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --navy-950: #0b1d2d;
        --navy-900: #102c40;
        --navy-800: #163d5d;
        --navy-700: #1b4d73;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --text: #1a1a1a;
        --muted: #556274;
        --warm: #f5f1eb;
        --light: #f9f9f7;
        --panel: #ffffff;
        --error: #b42318;
        --success: #0f766e;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: radial-gradient(circle at top, rgba(212,160,23,0.07), transparent 30%), linear-gradient(135deg, #f5f1eb 0%, #f9f9f7 100%);
        letter-spacing: 0.01em;
      }
      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; display: block; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.5);
        box-shadow: 0 10px 30px rgba(12, 26, 38, 0.18);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        max-width: 1220px;
        margin: 0 auto;
      }

      .site-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        color: #fff;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .nav-links {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: #fff;
        opacity: 0.85;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }

      .nav-links a:hover,
      .nav-links a.active {
        opacity: 1;
        transform: translateY(-1px);
      }

      .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.7rem;
        cursor: pointer;
      }

      .page-hero {
        position: relative;
        min-height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(120deg, rgba(8, 23, 33, 0.78), rgba(17, 39, 60, 0.82)), linear-gradient(135deg, #0d2a3d 0%, #153c5c 36%, #111b2a 100%);
        overflow: hidden;
      }

      .page-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(212,160,23,0.14), transparent 34%), repeating-linear-gradient(45deg, rgba(255,255,255,0.02), rgba(255,255,255,0.02) 2px, transparent 2px, transparent 12px);
      }

      .hero-content {
        position: relative;
        z-index: 1;
        text-align: center;
        color: #fff;
        max-width: 760px;
        padding: 2rem 1.5rem;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--gold-600);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .eyebrow-dark {
        color: var(--gold-600);
      }

      .hero-content h1 {
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 1.08;
        margin-bottom: 1rem;
        letter-spacing: -0.04em;
      }

      .hero-content p {
        font-size: 1.08rem;
        opacity: 0.92;
      }

      .request-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 2rem 2rem;
        display: grid;
        grid-template-columns: 1.5fr 0.85fr;
        gap: 2rem;
      }

      .panel {
        background: rgba(255,255,255,0.9);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        box-shadow: 0 18px 40px rgba(13,29,45,0.08);
      }

      .request-panel {
        padding: 2rem;
      }

      .request-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        font-weight: 600;
        color: #173953;
      }

      .full-width {
        grid-column: 1 / -1;
      }

      input, select, textarea {
        width: 100%;
        padding: 0.85rem 1rem;
        border: 2px solid #dfe5ea;
        border-radius: 10px;
        font-size: 1rem;
        font-family: inherit;
        background: #fbfbfb;
        color: var(--text);
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold-600);
        box-shadow: 0 0 0 3px rgba(212,160,23,0.12);
      }

      textarea {
        resize: vertical;
      }

      .upload-field small {
        color: var(--muted);
        font-weight: 500;
      }

      .summary-panel {
        padding: 2rem;
        height: fit-content;
        background: linear-gradient(135deg, #17395a 0%, #0e2134 100%);
        color: #fff;
      }

      .summary-panel .section-tag {
        color: var(--gold-600);
      }

      .summary-panel h2 {
        margin: 0.5rem 0 1.5rem;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: #fff;
      }

      .summary-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.15);
      }

      .summary-item span {
        opacity: 0.75;
      }

      .summary-item strong {
        text-align: right;
        color: #fff;
      }

      .summary-item.highlight {
        margin-top: 0.25rem;
        padding-top: 1rem;
      }

      .summary-panel p {
        margin-top: 1.25rem;
        color: rgba(255,255,255,0.8);
      }

      .detailed-pricing-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 4rem;
      }

      .section-header-row {
        text-align: center;
        margin-bottom: 2rem;
      }

      .section-header-row h2 {
        font-size: clamp(2rem, 3vw, 2.8rem);
        color: #142e40;
      }

      .detailed-pricing-list {
        display: grid;
        gap: 2rem;
      }

      .pricing-group {
        background: rgba(255,255,255,0.8);
        border: 1px solid rgba(20,46,64,0.08);
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 12px 28px rgba(13,29,45,0.04);
      }

      .pricing-group h3 {
        margin-bottom: 1rem;
        color: #173953;
        font-size: 1.4rem;
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
      }

      .price-card {
        border: 1px solid rgba(20,46,64,0.12);
        border-radius: 14px;
        padding: 1rem;
        background: #fff;
      }

      .price-card h4 {
        color: #173953;
        margin-bottom: 0.5rem;
      }

      .price-range {
        color: var(--gold-600);
        font-weight: 800;
        margin-bottom: 0.75rem;
      }

      .price-card ul {
        list-style: none;
        display: grid;
        gap: 0.4rem;
        color: #536070;
      }

      .price-card li::before {
        content: '✓ ';
        color: var(--gold-600);
        font-weight: 700;
      }

      .form-status {
        min-height: 1.5rem;
        font-size: 0.96rem;
        font-weight: 600;
        display: none;
      }

      .form-status.success {
        display: block;
        color: var(--success);
      }

      .form-status.error {
        display: block;
        color: var(--error);
      }

      .btn {
        display: inline-block;
        padding: 0.875rem 2rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        border: none;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color: #1a1a1a;
        box-shadow: 0 10px 24px rgba(212,160,23,0.28);
      }

      .btn-primary:hover {
        background: linear-gradient(135deg, #e7b93f, #d1a02c);
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(212,160,23,0.35);
      }

      .btn-full {
        width: 100%;
        text-align: center;
      }

      footer {
        background: linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color: #fff;
        padding: 3rem 2rem 2rem;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
      }

      .footer-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
      }

      .footer-brand-text {
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer-content > p {
        opacity: 0.7;
        margin-bottom: 1rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .footer-nav a {
        opacity: 0.8;
        transition: opacity 0.2s ease;
      }

      .footer-nav a:hover {
        opacity: 1;
      }

      .license-number {
        margin-top: 1rem;
        color: var(--gold-600);
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .copyright {
        font-size: 0.875rem;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        .nav-toggle { display: block; }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(15, 29, 43, 0.98);
          flex-direction: column;
          padding: 1rem 2rem;
          gap: 1rem;
          z-index: 10;
        }
        .nav-links.open { display: flex; }
        .request-layout,
        .form-grid { grid-template-columns: 1fr; }
        .request-layout { padding-top: 2rem; }
      }
    </style>

    <script>
      const projectType = document.getElementById('project-type');
      const projectScope = document.getElementById('project-scope');
      const summaryScope = document.getElementById('summary-scope');
      const summaryPrice = document.getElementById('summary-price');
      const detailedPricingList = document.getElementById('detailed-pricing-list');
      const quoteForm = document.getElementById('quote-form');
      const quoteStatus = document.getElementById('quote-status');

      const projectValues = {
        waterDamageRestoration: {
          label: 'Water Damage Restoration',
          options: {
            minor: { label: 'Minor Water Damage', price: '$1,500 - $5,000' },
            moderate: { label: 'Moderate Water Damage', price: '$5,000 - $15,000' },
            major: { label: 'Major Water Damage', price: '$15,000 - $50,000+' }
          }
        },
        waterDamageReconstruction: {
          label: 'Water Damage Reconstruction',
          options: {
            singleRoom: { label: 'Single Room', price: '$5,000 - $12,000' },
            multipleRooms: { label: 'Multiple Rooms', price: '$12,000 - $35,000' },
            wholeHome: { label: 'Whole-Home Restoration', price: '$35,000 - $150,000+' }
          }
        },
        fire: {
          label: 'Fire & Smoke Damage Repair',
          options: {
            minor: { label: 'Minor', price: '$3,000 - $15,000' },
            moderate: { label: 'Moderate', price: '$15,000 - $50,000' },
            severe: { label: 'Severe', price: '$50,000 - $250,000+' }
          }
        },
        structural: {
          label: 'Structural Damage Repair',
          options: {
            localized: { label: 'Localized Structural Repair', price: '$5,000 - $25,000' },
            major: { label: 'Major Structural Repair', price: '$25,000 - $100,000+' }
          }
        }
      };

      function buildDetailCards() {
        detailedPricingList.innerHTML = Object.entries(estimateMap)
          .map(([key, project]) => {
            const cards = Object.values(project.options)
              .map((option) => `
                <div class="price-card">
                  <h4>${option.label}</h4>
                  <p class="price-range">${option.price}</p>
                  <ul>
                    ${(estimateMap[key].options[Object.keys(estimateMap[key].options).find((scopeKey) => estimateMap[key].options[scopeKey].label === option.label)]?.scope || []).map((item) => `<li>${item}</li>`).join('')}
                  </ul>
                </div>
              `)
              .join('');

            return `
              <div class="pricing-group">
                <h3>${project.label}</h3>
                <div class="pricing-grid">${cards}</div>
              </div>
            `;
          })
          .join('');
      }

      function syncScopeOptions() {
        const selected = projectType.value;
        const options = projectValues[selected]?.options || {};
        const entries = Object.entries(options);

        projectScope.innerHTML = `
          <option value="" disabled ${entries.length ? '' : 'selected'}>Select scope</option>
          ${entries.map(([key, value]) => `<option value="${key}">${value.label}</option>`).join('')}
        `;

        const selectedScope = entries[0]?.[0] || '';
        if (selectedScope) {
          projectScope.value = selectedScope;
        }

        updateSummary();
      }

      function updateSummary() {
        const selected = projectType.value;
        const scope = projectScope.value;
        const scopeData = projectValues[selected]?.options?.[scope];

        if (summaryScope && scopeData) {
          summaryScope.textContent = scopeData.label;
        }

        if (summaryPrice && scopeData) {
          summaryPrice.textContent = scopeData.price;
        }
      }

      if (quoteForm && quoteStatus) {
        quoteForm.addEventListener('submit', async (event) => {
          event.preventDefault();

          const formData = new FormData(quoteForm);
          quoteStatus.className = 'form-status';
          quoteStatus.textContent = 'Sending your quote request...';
          quoteStatus.style.display = 'block';

          try {
            const response = await fetch('/api/quote', {
              method: 'POST',
              body: formData
            });

            const result = await response.json();
            if (!response.ok) {
              throw new Error(result?.message || 'There was a problem sending your request.');
            }

            quoteStatus.className = 'form-status success';
            quoteStatus.textContent = result?.message || 'Your quote request was sent successfully.';
            quoteForm.reset();
            syncScopeOptions();
          } catch (error) {
            quoteStatus.className = 'form-status error';
            quoteStatus.textContent = error instanceof Error ? error.message : 'There was a problem sending your request.';
          }
        });
      }

      projectType.addEventListener('change', syncScopeOptions);
      projectScope.addEventListener('change', updateSummary);

      buildDetailCards();
      syncScopeOptions();
    </script>
  </body>
</html>
