        fire: { label: 'Fire & Smoke Damage Repair', options: { minor: { label: 'Minor', price: '$3,000 - $15,000' }, moderate: { label: 'Moderate', price: '$15,000 - $50,000' }, severe: { label: 'Severe', price: '$50,000 - $250,000+' } } },
