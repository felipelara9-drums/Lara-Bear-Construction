---
const companyName = "Lara Bear Construction";
const email = "larabearco@outlook.com";
const phone = "559-892-6331";
const phoneClean = "5598926331";

const estimateMap = {
  water: {
    label: "Water Damage",
    options: {
      small: { label: "Small Area", price: "$1,500 - $4,000" },
      medium: { label: "Medium Area", price: "$4,000 - $15,000" },
      large: { label: "Large Area", price: "$15,000 - $30,000+" }
    }
  },
  fire: {
    label: "Fire & Smoke Damage",
    options: {
      minor: { label: "Minor", price: "$3,000 - $15,000" },
      moderate: { label: "Moderate", price: "$15,000 - $50,000" },
      severe: { label: "Severe", price: "$50,000 - $250,000+" }
    }
  },
  storm: {
    label: "Storm Damage",
    options: {
      minor: { label: "Minor", price: "$2,500 - $10,000" },
      moderate: { label: "Moderate", price: "$10,000 - $35,000" },
      major: { label: "Major", price: "$35,000 - $150,000+" }
    }
  },
  structural: {
    label: "Structural Damage",
    options: {
      localized: { label: "Localized Repair", price: "$5,000 - $25,000" },
      major: { label: "Major Repair", price: "$25,000 - $100,000+" }
    }
  }
};

const projectParam = Astro.url.searchParams.get('project') || 'water';
const scopeParam = Astro.url.searchParams.get('scope') || Object.keys(estimateMap[projectParam].options)[0];
const selectedProjectLabel = estimateMap[projectParam]?.label || 'Water Damage';
const selectedScopeLabel = estimateMap[projectParam]?.options?.[scopeParam]?.label || 'Small Area';
const selectedPrice = estimateMap[projectParam]?.options?.[scopeParam]?.price || '$1,500 - $4,000';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Detailed quote request form for Lara Bear Construction." />
    <title>Request a Quote | Lara Bear Construction</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="site-brand" aria-label="Lara Bear Construction home">Lara Bear Construction</a>

        <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/restoration-remodeling">Restoration</a></li>
          <li><a href="/quote" class="active">Free Quote</a></li>
          <li><a href="/quote-request">Detailed Quote</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="page-hero">
        <div class="hero-content">
          <p class="eyebrow">Detailed quote request</p>
          <h1>Tell us about your project</h1>
          <p>We’ll review your details and follow up with a personalized estimate for your restoration or repair project.</p>
        </div>
      </section>

      <section class="request-layout">
        <div class="request-panel panel">
          <form class="request-form" onsubmit="event.preventDefault(); window.location.href='mailto:larabearco@outlook.com?subject=Detailed Quote Request';">
            <div class="form-grid">
              <label>
                Full name
                <input type="text" name="name" placeholder="Your Name" required />
              </label>

              <label>
                Email address
                <input type="email" name="email" placeholder="you@example.com" required />
              </label>

              <label>
                Phone number
                <input type="tel" name="phone" placeholder="(555) 123-4567" />
              </label>

              <label>
                Project type
                <select id="project-type" name="projectType">
                  <option value="water" selected={projectParam === 'water'}>Water Damage</option>
                  <option value="fire" selected={projectParam === 'fire'}>Fire & Smoke Damage</option>
                  <option value="storm" selected={projectParam === 'storm'}>Storm Damage</option>
                  <option value="structural" selected={projectParam === 'structural'}>Structural Damage</option>
                </select>
              </label>

              <label>
                Scope of work
                <select id="project-scope" name="scope">
                  <option value="" disabled selected={!scopeParam}>Select scope</option>
                </select>
              </label>

              <label>
                Service area
                <input type="text" name="location" placeholder="City / Neighborhood" />
              </label>

              <label class="full-width">
                Project details
                <textarea name="details" rows="6" placeholder="Tell us about the project, timeline, and any concerns"></textarea>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Send Request</button>
          </form>
        </div>

        <aside class="summary-panel panel">
          <span class="section-tag">Selected estimate</span>
          <h2>{selectedProjectLabel}</h2>
          <div class="summary-item">
            <span>Scope</span>
            <strong id="summary-scope">{selectedScopeLabel}</strong>
          </div>
          <div class="summary-item highlight">
            <span>Estimated range</span>
            <strong id="summary-price">{selectedPrice}</strong>
          </div>
          <p>
            This estimate is a starting point for planning. Final pricing depends on site conditions, materials, access, and project details.
          </p>
        </aside>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-brand">
          <span class="footer-brand-text">Lara Bear Construction</span>
        </div>
        <p>Restoration / Remodeling</p>

        <nav class="footer-nav">
          <a href="/">Home</a>
          <a href="/restoration-remodeling">Restoration</a>
          <a href="/quote">Free Quote</a>
          <a href="/quote-request">Detailed Quote</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <p class="license-number">CSLB License #1159060</p>
        <p class="copyright">&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const projectType = document.getElementById('project-type');
      const projectScope = document.getElementById('project-scope');
      const summaryScope = document.getElementById('summary-scope');
      const summaryPrice = document.getElementById('summary-price');

      const projectValues = {
        water: { label: 'Water Damage', options: { small: { label: 'Small Area', price: '$1,500 - $4,000' }, medium: { label: 'Medium Area', price: '$4,000 - $15,000' }, large: { label: 'Large Area', price: '$15,000 - $30,000+' } } },
        fire: { label: 'Fire & Smoke Damage', options: { minor: { label: 'Minor', price: '$3,000 - $15,000' }, moderate: { label: 'Moderate', price: '$15,000 - $50,000' }, severe: { label: 'Severe', price: '$50,000 - $250,000+' } } },
        storm: { label: 'Storm Damage', options: { minor: { label: 'Minor', price: '$2,500 - $10,000' }, moderate: { label: 'Moderate', price: '$10,000 - $35,000' }, major: { label: 'Major', price: '$35,000 - $150,000+' } } },
        structural: { label: 'Structural Damage', options: { localized: { label: 'Localized Repair', price: '$5,000 - $25,000' }, major: { label: 'Major Repair', price: '$25,000 - $100,000+' } } }
      };

      function syncScopeOptions() {
        const selected = projectType.value;
        const options = projectValues[selected]?.options || {};
        const entries = Object.entries(options);

        projectScope.innerHTML = `
          <option value="" disabled ${entries.length ? '' : 'selected'}>Select scope</option>
          ${entries.map(([key, value]) => `<option value="${key}">${value.label}</option>`).join('')}
        `;

        const selectedScope = entries[0]?.[0] || '';
        if (selectedScope) {
          projectScope.value = selectedScope;
        }

        updateSummary();
      }

      function updateSummary() {
        const selected = projectType.value;
        const scope = projectScope.value;
        const scopeData = projectValues[selected]?.options?.[scope];

        if (summaryScope && scopeData) {
          summaryScope.textContent = scopeData.label;
        }

        if (summaryPrice && scopeData) {
          summaryPrice.textContent = scopeData.price;
        }
      }

      projectType.addEventListener('change', syncScopeOptions);
      projectScope.addEventListener('change', updateSummary);

      const initialProject = "${projectParam}";
      const initialScope = "${scopeParam}";
      if (projectType && projectScope) {
        projectType.value = initialProject;
        syncScopeOptions();
        if (initialScope && projectValues[initialProject]?.options[initialScope]) {
          projectScope.value = initialScope;
          updateSummary();
        }
      }
    </script>

    <style is:global>
      :root {
        --navy-950: #0b1d2d;
        --navy-900: #102c40;
        --navy-800: #163d5d;
        --navy-700: #1b4d73;
        --gold-600: #d4a017;
        --gold-700: #c6941b;
        --text: #1a1a1a;
        --muted: #556274;
        --warm: #f5f1eb;
        --light: #f9f9f7;
        --panel: #ffffff;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.6;
        color: var(--text);
        background: linear-gradient(135deg, #f5f1eb 0%, #f9f9f7 100%);
      }
      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; display: block; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 29, 43, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(212, 160, 23, 0.5);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        max-width: 1220px;
        margin: 0 auto;
      }

      .site-brand {
        color: #fff;
        font-weight: 800;
        font-size: 1.08rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .nav-links {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: #fff;
        opacity: 0.85;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
      }

      .nav-links a.active,
      .nav-links a:hover {
        opacity: 1;
      }

      .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.7rem;
        cursor: pointer;
      }

      .page-hero {
        background: linear-gradient(135deg, rgba(11, 29, 45, 0.8), rgba(22, 61, 93, 0.82));
        padding: 5rem 2rem 4rem;
      }

      .hero-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
        color: #fff;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--gold-600);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .hero-content h1 {
        font-size: clamp(2.3rem, 4vw, 4rem);
        margin-bottom: 1rem;
      }

      .hero-content p {
        max-width: 700px;
        margin: 0 auto;
        font-size: 1.06rem;
        opacity: 0.92;
      }

      .request-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 5rem;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 2rem;
      }

      .panel {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(20, 46, 64, 0.08);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 18px 38px rgba(13, 29, 45, 0.06);
      }

      .request-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .full-width {
        grid-column: 1 / -1;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-weight: 600;
        color: #1d2a36;
      }

      input, select, textarea, button {
        font: inherit;
      }

      input, select, textarea {
        width: 100%;
        padding: 0.9rem 1rem;
        border: 2px solid #dde5eb;
        border-radius: 10px;
        background: #fbfbfb;
        color: var(--text);
      }

      textarea {
        resize: vertical;
      }

      select {
        appearance: auto;
        -webkit-appearance: menulist;
        -moz-appearance: menulist;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold-600);
      }

      .btn {
        display: inline-block;
        padding: 0.9rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold-600), var(--gold-700));
        color: #1a1a1a;
        box-shadow: 0 10px 24px rgba(212, 160, 23, 0.28);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(212, 160, 23, 0.35);
      }

      .btn-full {
        width: 100%;
      }

      .section-tag {
        display: inline-block;
        color: var(--gold-600);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
      }

      .summary-panel {
        align-self: start;
      }

      .summary-panel h2 {
        margin: 0.5rem 0 1.5rem;
        color: #142e40;
        font-size: clamp(1.8rem, 2vw, 2.5rem);
      }

      .summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1rem 1.1rem;
        border-radius: 12px;
        background: #f6f8fa;
        margin-bottom: 1rem;
      }

      .summary-item span {
        color: var(--muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .summary-item strong {
        font-size: 1.4rem;
        color: #122d3d;
      }

      .summary-item.highlight {
        background: linear-gradient(135deg, #0d1f2f 0%, #17395a 100%);
      }

      .summary-item.highlight strong,
      .summary-item.highlight span {
        color: #fff;
      }

      .summary-panel p {
        margin-top: 1.25rem;
        color: var(--muted);
        line-height: 1.7;
      }

      footer {
        background: linear-gradient(135deg, #0b1d2d 0%, #162f46 100%);
        color: #fff;
        padding: 3rem 2rem 2rem;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
      }

      .footer-brand-text {
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer-content > p {
        opacity: 0.7;
        margin-bottom: 1rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .footer-nav a {
        opacity: 0.8;
      }

      .footer-nav a:hover {
        opacity: 1;
      }

      .license-number {
        margin-top: 1rem;
        color: var(--gold-600);
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .copyright {
        font-size: 0.875rem;
        opacity: 0.55;
      }

      @media (max-width: 768px) {
        .nav-toggle { display: block; }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(15, 29, 43, 0.98);
          flex-direction: column;
          padding: 1rem 2rem;
          gap: 1rem;
          z-index: 10;
        }
        .nav-links.open { display: flex; }

        .request-layout, .form-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
